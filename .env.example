# TerraTwin server configuration (all optional). Copy to .env or export before starting uvicorn.
# Serving release directory under prepared/; default comes from prepared/current_release.json.
# TERRATWIN_RELEASE_DIR=prepared/0.2.0
# Lunar DEM for point telemetry (search works without it). Download: see analysis/RUNBOOK.md.
# TERRATWIN_LDEM=frontend/ldem_64.tif
# Rendered Moon/Mars imagery tile cache (~25 MB per world for levels 0-4, grows with browsing).
# TERRATWIN_TILE_CACHE=frontend/tile_cache
# 0 disables background imagery prewarming (avoids CPU contention in the first minutes after start).
TERRATWIN_PREWARM=1
# 0 skips the one-time USGS Gazetteer label download (committed label files are used if present).
TERRATWIN_FETCH_LABELS=1
# Maximum simultaneous searches; each can briefly use ~150-250 MB.
TERRATWIN_MAX_CONCURRENT_SEARCHES=4
