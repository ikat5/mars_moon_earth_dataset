 "sources": [
  {
   "id": "moon_lola_ldem64",
   "name": "LRO LOLA Gridded DEM, 64 pixels/degree (LDEM_64)",
   "provider": "NASA PDS Geosciences Node (LRO LOLA team, GSFC)",
   "measurement_type": "measurement",
   "native_resolution": "64 px/deg (473.8 m/px at equator)",
   "citation": "Smith D.E. et al. (2010) GRL 37, L18204; Neumann G.A. (2010) LRO-L-LOLA-4-GDR-V1.0, NASA PDS.",
   "limitations": "Interpolated between LOLA tracks at low latitudes (track gaps up to ~1-2 km); slopes below ~1 km baseline are not resolved."
  },
  {
   "id": "moon_diviner_gcp",
   "name": "Diviner Global Cumulative Product - binned brightness/bolometric temperatures by local time",
   "provider": "NASA PDS Geosciences Node (Diviner team, UCLA)",
   "measurement_type": "measurement",
   "native_resolution": "0.5 deg x 0.25 h local time",
   "citation": "Williams J.-P. et al. (2017) Icarus 283, 300-325.",
   "limitations": "Binned average of nadir observations; -9999 = no observation; 0.5 deg bins cannot resolve km-scale cold traps."
  },
  {
   "id": "moon_diviner_prp",
   "name": "Diviner Polar Resource Product (annual temperatures and ice-stability depth)",
   "provider": "NASA PDS Geosciences Node (Diviner team, UCLA)",
   "measurement_type": "model",
   "native_resolution": "~240 m triangular facets",
   "citation": "Paige D.A. et al. (2010) Science 330, 479; Siegler M.A. et al. (2016) Nature 531, 480.",
   "limitations": "temp_avg/ice_depth come from a thermal model constrained by Diviner, not direct observation of ice."
  },
  {
   "id": "moon_diviner_rockabundance",
   "name": "Diviner rock abundance and regolith (soil) temperature, 32 ppd",
   "provider": "NASA PDS Geosciences Node (Diviner team)",
   "measurement_type": "derived_measurement",
   "native_resolution": "32 px/deg (~948 m)",
   "citation": "Bandfield J.L. et al. (2011) JGR 116, E00H02.",
   "limitations": "Retrieval assumes two-component (rock + regolith) surface; rocks are >~1 m; poleward of 60 deg not provided."
  },
  {
   "id": "moon_lp_grs",
   "name": "Lunar Prospector GRS elemental abundances (2 deg equal-area)",
   "provider": "NASA PDS Geosciences Node (Prettyman et al.)",
   "measurement_type": "derived_measurement",
   "native_resolution": "2 deg equal-area pixels (~60 km); sensor footprint ~45 km FWHM at 30 km altitude",
   "citation": "Prettyman T.H. et al. (2006) JGR 111, E12007.",
   "limitations": "Low spatial resolution; values are footprint-averaged; oxides constrained to sum with model assumptions."
  },
  {
   "id": "moon_lp_neutrons",
   "name": "Lunar Prospector epithermal / thermal / fast neutron counting rates",
   "provider": "NASA PDS Geosciences Node (Lunar Prospector reduced special products)",
   "measurement_type": "measurement",
   "native_resolution": "2 deg equal-area (~60 km bins)",
   "citation": "Feldman W.C. et al. (2001) JGR 106, 23231; Maurice S. et al. (2004) JGR 109, E07S04.",
   "limitations": "Count rates are an INDIRECT hydrogen proxy (lower epithermal = more H); also sensitive to composition; not converted to WEH here."
  },
  {
   "id": "moon_grail_gravity",
   "name": "GRAIL GRGM900C Bouguer anomaly and free-air anomaly error maps (l<=600)",
   "provider": "NASA PDS Geosciences Node (GRAIL)",
   "measurement_type": "derived_measurement",
   "native_resolution": "spherical-harmonic degree 600 (~9 km half-wavelength)",
   "citation": "Lemoine F.G. et al. (2014) GRL 41, 3382; Zuber M.T. et al. (2013) Science 339, 668.",
   "limitations": "Bouguer anomalies reflect density contrasts at many depths; NOT direct evidence of voids/caves."
  },
  {
   "id": "moon_robbins_craters",
   "name": "Robbins (2018) Lunar Crater Database",
   "provider": "USGS Astrogeology (Astropedia)",
   "measurement_type": "catalog",
   "native_resolution": "craters D >= ~1-2 km (statistically complete)",
   "citation": "Robbins S.J. (2019) JGR Planets 124, 871-892.",
   "limitations": "Manual catalog; completeness varies with illumination/data; no degradation state."
  },
  {
   "id": "moon_unified_geology",
   "name": "Unified Geologic Map of the Moon, 1:5M (2020)",
   "provider": "USGS Astrogeology",
   "measurement_type": "map_interpretation",
   "native_resolution": "1:5,000,000",
   "citation": "Fortezzo C.M. et al. (2020) USGS Unified Geologic Map of the Moon, 1:5M.",
   "limitations": "Interpretive map compiled from six regional maps; unit boundaries generalized."
  },
  {
   "id": "moon_lroc_pits",
   "name": "LROC Lunar Pit Locations (Lunar Pit Atlas)",
   "provider": "LROC Science Operations Center / NASA PDS (LRO-L-LROC-5-RDR-V1.0 extras)",
   "measurement_type": "catalog",
   "native_resolution": "point catalog (NAC 0.5-2 m imagery)",
   "citation": "Wagner R.V. & Robinson M.S. (2021) Lunar Pit Atlas; Robinson M.S. et al. (2012) PSS 69, 18.",
   "limitations": "Pits are skylight candidates; subsurface extent unknown for nearly all."
  },
  {
   "id": "moon_pgda_illumination",
   "name": "PGDA polar average solar visibility (illumination) maps",
   "provider": "NASA GSFC Planetary Geodesy Data Archive (product 69)",
   "measurement_type": "model",
   "native_resolution": "240 m",
   "citation": "Mazarico E. et al. (2011) Icarus 211, 1066.",
   "limitations": "Computed from LOLA topography (ray-casting), not observed; local horizons < 240 m unresolved."
  },
  {
   "id": "moon_model_geometry",
   "name": "Analytic orbital-geometry model (insolation, Earth visibility, liquid-water impossibility)",
   "provider": "TerraTwin derivation from standard celestial mechanics",
   "measurement_type": "model",
   "native_resolution": "analytic (per latitude / per cell)",
   "citation": "Standard insolation formula (e.g., Berger 1978); lunar optical libration amplitudes 7.9 deg / 6.7 deg.",
   "limitations": "Bare-sphere horizon (no topographic shadowing - use PGDA illumination near poles); S0 = 1361 W/m2."
  }
 ],
